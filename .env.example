# Copy this file to `.env` (same directory) and fill in the real values.
# Both come from the Supabase dashboard: Project Settings -> API Keys
# -> "Publishable and secret API keys" tab. Never commit the real `.env`.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
